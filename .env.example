# Copiar este archivo como `.env` y completar los valores.
# NUNCA subir ni compartir el archivo `.env` real.

# ── Base de datos ──────────────────────────────────────────────

# Conexión que usa la aplicación en tiempo de ejecución (src/lib/prisma.js).
# En Supabase: el "transaction pooler" (puerto 6543).
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Conexión directa / de sesión que usa la CLI de Prisma para las migraciones (prisma.config.ts).
# En Supabase: el "session pooler" (puerto 5432) o la conexión directa.
# En un PostgreSQL común (local o propio) puede ser la misma URL que DATABASE_URL.
DIRECT_URL="postgresql://USUARIO:PASSWORD@HOST:5432/postgres"

# ── Acceso ─────────────────────────────────────────────────────

# Tu clave de administrador: permite todas las escrituras (editar sensores y perfiles).
# Generá una con: npm run clients -- admin-key
# Sin definir, solo pueden escribir los clientes creados con `npm run clients -- create`.
ADMIN_API_KEY=""

# Dominios que pueden llamar a la API desde un navegador, separados por coma.
# "*" = cualquiera. Sin definir: solo https://sensorescinemark.netlify.app
# No afecta al gateway ni a llamadas desde otro servidor (CORS es solo para navegadores).
CORS_ORIGINS="https://sensorescinemark.netlify.app"

# ── Opcionales ─────────────────────────────────────────────────

# Puerto HTTP. Render lo define solo; en local, por defecto 5000.
# PORT=5000

# Minutos sin datos para considerar un sensor "offline" (por defecto 30).
# SENSOR_OFFLINE_MINUTES=30

# true = un devEUI desconocido crea un sensor nuevo (comportamiento anterior).
# Por defecto false: los sensores se registran con `npm run sensors -- add <devEui>`.
# TELEMETRY_AUTO_CREATE=false

# Límites de pedidos (valores en src/config.js). "false" los apaga; la telemetría nunca se limita.
# RATE_LIMIT_ENABLED=true

# Header con la IP real de quien llama. En Render lo escribe Cloudflare. "none" = no usar ninguno.
# Verificá en GET /api/me que "ip" sea la tuya.
# CLIENT_IP_HEADER=cf-connecting-ip

# Proxies delante del servidor. Solo se usa si el pedido no trae CLIENT_IP_HEADER (por ejemplo en local).
# TRUST_PROXY=1

# Zona horaria para agrupar el historial por día (promedios diarios).
# TIME_ZONE=America/Argentina/Buenos_Aires
